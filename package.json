{
  "name": "support-ticket-triage-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build && npm run typecheck",
    "test": "vitest run --dir test",
    "test:watch": "vitest --dir test",
    "generate:fixtures": "node dist/scripts/generate-fixtures.js",
    "evaluate": "node dist/scripts/evaluate.js",
    "evaluate:diagnostics": "npm test -- --run test/diagnostic-evaluation.test.ts",
    "evaluate:lifecycle": "npm run build && node dist/scripts/evaluate-all-ticket-lifecycles.js",
    "evaluate:lifecycle-replay": "npm run build && node dist/scripts/evaluate-diagnostic-lifecycle-replay.js",
    "evaluate:ai-comparison": "npm run build && node dist/scripts/evaluate-ai-comparison.js",
    "evaluate:ai-diagnosis": "npm run build && node dist/scripts/evaluate-ai-diagnosis.js",
    "start": "node dist/src/index.js",
    "approval-desk": "node dist/src/approval-desk.js",
    "demo:approval-desk": "node dist/scripts/demo-approval-desk.js",
    "demo:skill-showcase": "node dist/scripts/demo-skill-showcase.js",
    "demo:knowledge-evolution": "npm run build && node dist/scripts/demo-knowledge-evolution.js",
    "demo:metrics": "npm run build && node dist/scripts/demo-metrics.js",
    "demo:showcase": "node dist/scripts/demo-approval-desk.js",
    "verify:portfolio": "npm run build && npm run typecheck && npx vitest run --dir test && npm run evaluate:diagnostics && npm run evaluate:lifecycle-replay && npm run demo:knowledge-evolution -- --verbose && npm run demo:metrics"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
